{
  "name": "probex",
  "version": "1.0.0",
  "private": true,
  "description": "Open-source Runtime Debugger",
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r clear && tsc -b",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck",
    "verify:fix": "pnpm lint:fix && pnpm format"
  },
  "keywords": [],
  "author": "Artem Horovyi",
  "license": "MIT",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
